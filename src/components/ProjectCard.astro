---
interface Props {
  image: string;
  date: string;
  tags: Array<string>;
  title: string;
  link: string;
}
const { image, link, date, tags, title } = Astro.props;
let x = 0;
---

<a
  href={link}
  target="_blank"
  class=" border border-neutral-800 p-4 bg-neutral-900/50 hover:border-cyan-700 transition-colors">
<div
  class={`flex  gap-4 w-fit sm:h-[90px] h-[100px]`}
>
  <div
    class="flex flex-col justify-evenly font-space h-full text-wrap overflow-ellipsis"
  >
    <h1 class="sm:text-2xl text-xl font-bold text-wrap m-0">{title}</h1>
<p class="text-sm text-neutral-400 font-normal">lorem ipsum</p>
    <div class="font-thin text-gray-400 mx-1 text-sm flex items-center gap-2">
      <label class="py-[1px]">{date}</label>
      <span class="text-white">•</span>
      <span class="flex gap-2">
        {
          tags.map((aloo) => {
            x++;
            const border = x % 3 ? x % 3 == 1 ? "border-[#C22129]" : "border-cyan-700" : "border-[#6D28D9]";
            return (
              <span
                class={
                  "border-[#C22129] border rounded-sm px-3 py-[1px] " + border
                }
              >
                {aloo}
              </span>
            );
          })
        }
      </span>
    </div>
  </div>
</div>
</a>
